#!/bin/bash
# lab: run, grade and reset the CKA practice labs from the jump host.

set -uo pipefail
export LAB_HOME=${LAB_HOME:-/opt/cka-lab}
source "$LAB_HOME/lib/common.sh"

PVE_ENV=/etc/cka-lab/pve.env           # PVE_URL, PVE_NODE, PVE_TOKEN (restricted API token)
LAB_ENV=/etc/cka-lab/lab.env           # VM IDs (copied from infra/lab.env)
EXAM_MINUTES=120
EXAM_PASS=66

usage() {
  cat <<EOF
${c_bold}lab${c_off} - CKA practice lab (Kubernetes v1.35 curriculum)

  lab list                      labs with status and last score
  lab show <id>                 print a lab's tasks
  lab start <id> [phase]        prepare the cluster for a lab (runs its setup; some labs have phases);
                                labs with randomised values draw new ones (--same keeps them)
  lab up <id> [phase]           spin a lab up on demand: build any missing prerequisite labs
                                with the reference solutions (output hidden), then start it
  lab check <id>                grade a lab
  lab solution <id>             show the worked solution (after you've tried!)
  lab cleanup <id> [--yes]      remove what a finished lab left behind (keeps what later labs need)

  lab exam <n> start            begin mock exam <n>: sets up all tasks, 120 min timer
  lab exam <n> prep             build the labs the exam assumes, if missing (as lab up does)
  lab exam <n> up               prep, then start
  lab exam <n> begin [--snapshot]  prep, snapshot the cluster as before-exam<n>, then start
  lab exam <n> show [task]      print the exam paper, or one task
  lab exam <n> check            grade the exam (weighted, pass mark ${EXAM_PASS}%)
  lab exam <n> status           time remaining
  lab exam <n> cleanup [--yes]  remove the exam's leftovers (lab reset before-exam<n> is cleaner)

  lab drill [list]              speed drills: one task, a tight clock, new values each time
  lab drill <id>|random [dom]   start one (the clock runs until lab drill check passes)
  lab drill check <id>          grade it and record the time
  lab drill cleanup <id>        remove what it created

  lab playground [core|full] [--rebuild]
                                a working cluster to experiment on. The first time it's built with the
                                reference solutions and saved as a live snapshot (with the VMs' memory);
                                after that it's restored from it in under a minute (replacing the cluster):
                                core = HA control plane + 2 workers on v1.35 (labs 01-07);
                                full = core + metrics-server, cert-manager, MetalLB, Traefik,
                                Envoy Gateway and NFS storage

  lab power [status]            power state of the lab VMs
  lab power on|off              start or shut down the cluster VMs (lab commands start them by themselves)
  lab power shutdown            shut down the cluster VMs, then this jump host

  lab snapshots                 list cluster snapshots
  lab snapshots delete <name>   delete a snapshot ("base" is protected)
  lab snapshot <name>           snapshot the nodes (briefly stops them) and jump's lab state
  lab reset <name>              roll the cluster back to a snapshot ("base" = bare Ubuntu);
                                grades, exam history and notes are kept

<id> is the number or folder name, e.g. 03 or 03-kubeadm-init.
EOF
}

# --- lab lookup ---------------------------------------------------------------

lab_dir() {
  local id=$1 d
  for d in "$LAB_HOME"/labs/"$id" "$LAB_HOME"/labs/"$(printf '%02d' "$((10#$id))" 2>/dev/null)"-*; do
    [[ -d $d ]] && { echo "$d"; return; }
  done 2>/dev/null
  d=$(compgen -G "$LAB_HOME/labs/${id}-*" | head -1)
  [[ -n $d ]] && { echo "$d"; return; }
  die "no lab '$id' (try: lab list)"
}

meta() { (source "$1/meta"; eval "echo \"\${$2:-}\""); }

cmd_list() {
  local d id title domain res score
  printf "${c_bold}%-26s %-8s %-52s %s${c_off}\n" LAB DOMAIN TITLE "LAST CHECK"
  for d in "$LAB_HOME"/labs/*/; do
    d=${d%/}; id=$(basename "$d")
    title=$(meta "$d" TITLE); domain=$(meta "$d" DOMAIN)
    res=$LAB_STATE/results/$id.json
    if [[ -f $res ]]; then
      score=$(jq -r '"\(.pass)/\(.total)"' "$res")
      [[ $(jq -r '.pass == .total' "$res") == true ]] && score="${c_green}${score} done${c_off}" || score="${c_yellow}${score}${c_off}"
    elif [[ -f $LAB_STATE/started/$id ]]; then score="${c_dim}started${c_off}"
    elif [[ -f $LAB_STATE/provisioned/$id ]]; then score="${c_dim}built by lab up${c_off}"
    else score="${c_dim}-${c_off}"; fi
    printf "%-26s %-8s %-52s %s\n" "$id" "$domain" "${title:0:52}" "$score"
  done
}

cmd_show() {
  local d f; d=$(lab_dir "$1"); f=$(mktemp --suffix=.md)
  render "$d/task.md" "$(basename "$d")" >"$f"
  if command -v glow >/dev/null; then glow -p "$f"; else less -FRX "$f"; fi
  rm -f "$f"
}

# Words for generated names: short, unambiguous, and unlike any Kubernetes keyword.
WORDS=(amber birch cedar delta ember fjord grove harbor indigo juniper kestrel lagoon maple nectar
  onyx pebble quartz raven sierra tundra umber vapor willow xenon yarrow zephyr cobalt dune falcon
  glacier heron ivory jade lynx meadow nimbus orchid pine)

# draw_params <lab dir> <id>: fresh values for this attempt, from the lab's params file.
#   KEY int LO HI [STEP] | KEY pick A B C | KEY word [PREFIX] | KEY hex [BYTES] | KEY calc EXPR
# Values may not repeat within one draw (two ports from one range stay distinct).
draw_params() {
  local spec=$1/params out k gen rest a v rnd tries
  [[ -f $spec ]] || return 0
  mkdir -p "$LAB_STATE/params"; out=$(params_file "$2")
  : >"$out.tmp"
  while read -r k gen rest; do
    [[ -z $k || $k == \#* ]] && continue
    read -ra a <<<"$rest"
    for tries in $(seq 1 50); do
      rnd=$(( (RANDOM << 15) | RANDOM ))
      case $gen in
        int)  v=$(( a[0] + rnd % ((a[1] - a[0]) / ${a[2]:-1} + 1) * ${a[2]:-1} )) ;;
        pick) v=${a[rnd % ${#a[@]}]} ;;
        word) v=${a[0]:+${a[0]}-}${WORDS[rnd % ${#WORDS[@]}]} ;;
        hex)  v=$(openssl rand -hex "${a[0]:-3}") ;;
        calc) v=$(source "$out.tmp"; echo $(( ${rest} ))) ;;
        *) die "$spec: unknown generator '$gen'" ;;
      esac
      [[ $gen == calc ]] || ! grep -q "=$(printf '%q' "$v")\$" "$out.tmp" && break
    done
    printf '%s=%q\n' "$k" "$v" >>"$out.tmp"
  done <"$spec"
  mv "$out.tmp" "$out"
}

cmd_start() {
  local d id same=0; d=$(lab_dir "$1"); id=$(basename "$d"); shift
  [[ ${*: -1} == --same ]] && { same=1; set -- "${@:1:$#-1}"; }
  # A new attempt gets new values; a phase (later in the same attempt) or --same keeps them.
  if [[ -f $d/params ]] && (( ! same )) && [[ -z ${1:-} || ! -f $(params_file "$id") ]]; then
    draw_params "$d" "$id"
  fi
  local needs; needs=$(meta "$d" NEEDS)
  [[ -n $needs ]] && info "This lab assumes these are done: $needs (lab up $id builds them)"
  [[ ${FUNCNAME[1]} == cmd_up ]] || ! past_lab "$d" ||
    info "${c_red}The cluster already has what $id builds.${c_off} For a clean attempt: lab up $id (rolls back and rebuilds what it needs)"
  if [[ -x $d/setup.sh ]]; then
    info "Preparing $id ..."
    GRADE_ID=$id bash "$d/setup.sh" "$@" || die "setup failed; fix the cluster (or lab reset) and retry"
  fi
  mkdir -p "$LAB_STATE/started"; date -u +%FT%TZ >"$LAB_STATE/started/$id"
  info "Ready. Read the tasks with: lab show $id"
}

cmd_check() {
  local d id; d=$(lab_dir "$1"); id=$(basename "$d")
  echo "${c_bold}Grading $id: $(meta "$d" TITLE)${c_off}"
  GRADE_ID=$id bash "$d/check.sh"
}

cmd_solution() {
  local d id f; d=$(lab_dir "$1"); id=$(basename "$d")
  f=$LAB_SOLUTIONS/labs/$id/solution.md
  [[ -f $f ]] || die "no solution installed for $id (solutions live in the private cka-lab-solutions repo)"
  read -rp "Show the solution for $id? Struggling first is where the learning happens. [y/N] " ok
  [[ $ok == y ]] || exit 0
  if command -v glow >/dev/null; then glow -p "$f"; else less -FRX "$f"; fi
}

# --- spin up on demand ----------------------------------------------------------
#
# Any lab can be started on a fresh cluster: its prerequisites (meta NEEDS, followed
# transitively) are built with the private reference solutions, exactly as the
# verified 01 -> 31 chain does it (start, solve, grade at 100%, cleanup). The solve
# output goes to a log so nothing about those labs is spoiled on screen.

# closure <ids...>: every lab these need, themselves included, highest first.
closure() {
  local seen=" " queue=("$@") n
  while (( ${#queue[@]} )); do
    n=$(basename "$(lab_dir "${queue[0]}")"); n=${n%%-*}; queue=("${queue[@]:1}")
    [[ $seen == *" $n "* ]] && continue
    seen+="$n "
    queue+=($(meta "$(lab_dir "$n")" NEEDS))
  done
  tr ' ' '\n' <<<"$seen" | grep . | sort -rn
}

# done_already <lab dir>: built by `lab up`, or its grader passes now. (A past pass
# isn't enough: grades outlive `lab reset`, the cluster state doesn't.)
done_already() {
  local id; id=$(basename "$1")
  [[ -f $LAB_STATE/provisioned/$id ]] && return 0
  GRADE_PROBE=1 GRADE_QUIET=1 GRADE_ID=$id timeout 300 bash "$1/check.sh" </dev/null >/dev/null 2>&1
}

# provision <ids...>: make sure every lab in the closure of <ids> is done.
provision() {
  local all ok=" " todo=() n d id t0 log
  all=$(closure "$@")
  [[ -z $all ]] && return 0
  [[ -d $LAB_SOLUTIONS/labs ]] || die "spinning up needs the reference solutions in $LAB_SOLUTIONS (infra/install-lab.sh --solutions <dir>)"
  info "Prerequisites: $(sort -n <<<"$all" | xargs)"
  # Highest first: a lab that's done vouches for everything it needed, so an early
  # lab is never re-run on a cluster that has moved past it (e.g. upgraded by 07).
  for n in $all; do
    [[ $ok == *" $n "* ]] && continue
    d=$(lab_dir "$n")
    if done_already "$d"; then
      printf '   %s %s\n' "${c_green}done${c_off}" "$(basename "$d")"
      ok+="$(closure "$n" | xargs) "
    else
      todo=("$n" "${todo[@]}")
    fi
  done
  (( ${#todo[@]} )) || { info "Everything this needs is in place"; return 0; }
  mkdir -p "$LAB_STATE/provisioned" "$LAB_STATE/up"
  # On a bare cluster (lab 01 not done) the core, labs 01-05, comes from the up-core
  # snapshot when there is one: a 3-minute rollback instead of a 25-minute build.
  # The jump host only gets things added, never removed, so nothing of yours is lost.
  local from_bare=0 cache=0
  [[ " ${todo[*]} " == *" 01 "* && " ${todo[*]} " == *" 05 "* ]] && from_bare=1
  if (( from_bare )) && cache_ok; then
    info "Restoring the cached core cluster (labs 01-05) from snapshot $CACHE_SNAP"
    rollback_nodes "$CACHE_SNAP" >/dev/null
    jump_restore "$CACHE_SNAP" add || die "couldn't restore the jump host's lab state from $CACHE_SNAP"
    rm -f "$GRADER_KUBECONFIG"
    wait_cluster || die "the cluster didn't come back Ready after the rollback; check lab status, then retry"
    for n in 01 02 03 04 05; do date -u +%FT%TZ >"$LAB_STATE/provisioned/$(basename "$(lab_dir "$n")")"; done
    info "Core cluster restored"
    local rest=(); for n in "${todo[@]}"; do (( 10#$n > 5 )) && rest+=("$n"); done; todo=("${rest[@]}")
    (( ${#todo[@]} )) || return 0
  elif (( from_bare )) && [[ -r $PVE_ENV ]]; then
    cache=1
  fi
  info "Building ${#todo[@]} lab(s) with the reference solutions; this can take a while"
  for n in $(printf '%s\n' "${todo[@]}" | sort -n); do
    d=$(lab_dir "$n"); id=$(basename "$d"); t0=$SECONDS
    log=$LAB_STATE/up/$id.log
    [[ -f $LAB_SOLUTIONS/labs/$id/solve.sh ]] || die "no reference solution for $id"
    printf '   %s %s: %s ... ' "${c_blue}build${c_off}" "$id" "$(meta "$d" TITLE)"
    # (No set -e here: bash ignores it in a command whose status is tested.)
    {
      echo "== $(date -u +%FT%TZ) setup" &&
      draw_params "$d" "$id" &&
      { [[ ! -x $d/setup.sh ]] || GRADE_ID=$id bash "$d/setup.sh"; } &&
      echo "== $(date -u +%FT%TZ) solve" &&
      GRADE_ID=$id bash "$LAB_SOLUTIONS/labs/$id/solve.sh"
    } </dev/null >"$log" 2>&1 || { echo "${c_red}failed${c_off}"; die "building $id failed (log: $log). Fix it, or lab reset base, and retry"; }
    GRADE_PROBE=1 GRADE_QUIET=1 GRADE_ID=$id bash "$d/check.sh" </dev/null >>"$log" 2>&1 \
      || { echo "${c_red}failed${c_off}"; die "$id didn't grade 100% after its reference solution (log: $log)"; }
    [[ -f $d/cleanup.sh ]] && bash "$d/cleanup.sh" </dev/null >>"$log" 2>&1
    date -u +%FT%TZ >"$LAB_STATE/provisioned/$id"
    echo "${c_green}ok${c_off} ${c_dim}$(( (SECONDS - t0) / 60 ))m$(( (SECONDS - t0) % 60 ))s${c_off}"
    if (( cache )) && [[ $n == 05 ]]; then
      info "Caching the core cluster as snapshot $CACHE_SNAP, so the next spin-up from scratch takes minutes"
      snapshot_nodes "$CACHE_SNAP" "lab up cache: labs 01-05 built by the reference solutions" >/dev/null \
        && jump_save "$CACHE_SNAP" "$(cache_key)" || info "caching failed; carrying on without it"
      wait_cluster || die "the cluster didn't come back Ready after the snapshot"
    fi
  done
}

CACHE_SNAP=up-core
# The cache is only good for what built it: labs 01-05's setup scripts and reference
# solution files. Task text, graders and docs can change without invalidating it.
cache_key() {
  find "$LAB_HOME"/labs/0[1-5]-* "$LAB_SOLUTIONS"/labs/0[1-5]-* -type f \
    ! -name '*.md' ! -name check.sh ! -name cleanup.sh ! -name meta -print0 2>/dev/null |
    sort -z | xargs -0 cat | sha1sum | cut -c1-12
}
cache_ok() {
  [[ -r $PVE_ENV && -f $JUMP_SNAPS/$CACHE_SNAP.tgz ]] || return 1
  [[ $(sudo tar -xzOf "$JUMP_SNAPS/$CACHE_SNAP.tgz" .lab-meta/key 2>/dev/null) == "$(cache_key)" ]] || return 1
  node_vm_snapshots | grep -qx "$CACHE_SNAP"
}

# Labs that build part of the cluster other labs, exams and drills stand on (01-05, the
# upgrade, MetalLB, ...): their cleanup leaves what they built in place.
building_labs() {
  closure $(sed -n 's/^NEEDS="\(.*\)"/\1/p' "$LAB_HOME"/{labs,exams,drills}/*/meta 2>/dev/null)
}

# past_lab <lab dir>: the cluster already has what this lab builds (after the playground,
# or after you did it), so doing it again there would be doing nothing.
past_lab() {
  local n; n=$(basename "$1"); n=${n%%-*}
  building_labs | grep -qx "$n" && done_already "$1"
}

# back_to_base: the nodes and the jump host's lab state back to bare Ubuntu, as lab reset base.
back_to_base() {
  [[ -f $JUMP_SNAPS/base.tgz ]] || die "no 'base' snapshot of the jump host's lab state; run lab reset base yourself"
  rollback_nodes base >/dev/null
  jump_restore base || die "couldn't restore the jump host's lab state from base"
  rm -f "$GRADER_KUBECONFIG" "$LAB_STATE/playground"
  date +%s >"$LAB_STATE/last-reset"
  local n
  for n in "${K8S_NODES[@]}" nfs; do wait_for 300 node_up "$n" || die "$n didn't come back after the rollback to base"; done
}

cmd_up() {
  local d id; d=$(lab_dir "$1"); id=$(basename "$d"); shift
  if past_lab "$d"; then
    info "The cluster already has what $id builds: rolling it back to bare Ubuntu, then building only what $id needs"
    back_to_base
  fi
  provision $(meta "$d" NEEDS)
  cmd_start "$id" "$@"
}

# run_cleanup <script> <label> [--yes]: show what will run, confirm, run it.
run_cleanup() {
  local script=$1 label=$2 yes=${3:-}
  echo "${c_bold}Cleanup for $label${c_off} will run:"
  echo
  render "$script" "${GRADE_ID:-}" | sed '1,/^set -uo pipefail$/d' | sed 's/^/    /'
  echo
  if [[ $yes != --yes ]]; then
    read -rp "Run it? [y/N] " ok
    [[ $ok == y ]] || { echo "Nothing changed."; return 0; }
  fi
  GRADE_ID=${GRADE_ID:-} bash "$script" && info "$label cleaned up" || info "$label cleanup finished with errors (see above); running it again is safe"
}

cmd_cleanup() {
  local d id; d=$(lab_dir "$1"); id=$(basename "$d")
  if [[ ! -f $d/cleanup.sh ]]; then
    info "Nothing to clean up for $id: it built part of the cluster the later labs use."
    info "Save this point instead: lab snapshot after-${id%%-*}"
    return 0
  fi
  GRADE_ID=$id run_cleanup "$d/cleanup.sh" "$id" "${2:-}"
}

# --- mock exams ----------------------------------------------------------------

# exam_contexts <n> <dir> set|delete: one kubeconfig context per task (e1-t3 for task 3,
# default namespace e1-t3), as the real exam names a context at the top of every task.
exam_contexts() {
  local n=$1 d=$2 action=$3 t ctx cluster user
  command -v kubectl >/dev/null && [[ -f $HOME/.kube/config ]] || return 0
  cluster=$(kubectl config view --minify -o jsonpath='{.contexts[0].context.cluster}' 2>/dev/null)
  user=$(kubectl config view --minify -o jsonpath='{.contexts[0].context.user}' 2>/dev/null)
  for t in "$d"/tasks/*/; do
    ctx=e$n-t$((10#$(basename "$t" | cut -c1-2)))
    if [[ $action == set ]]; then
      [[ -n $cluster && -n $user ]] && kubectl config set-context "$ctx" --cluster="$cluster" --user="$user" --namespace="$ctx" >/dev/null
    else
      kubectl config delete-context "$ctx" >/dev/null 2>&1
    fi
  done
}

exam_dir() { [[ -d $LAB_HOME/exams/$1 ]] || die "no mock exam $1"; echo "$LAB_HOME/exams/$1"; }

cmd_exam() {
  local n=${1:-} action=${2:-show} d st; [[ -n $n ]] || { usage; exit 2; }
  d=$(exam_dir "$n"); st=$LAB_STATE/exam-$n
  case $action in
    prep) provision $(meta "$d" NEEDS) ;;
    up) provision $(meta "$d" NEEDS) && cmd_exam "$n" start ;;
    begin)   # everything the web console's Start does, in one go: prep, snapshot, start
      provision $(meta "$d" NEEDS) || exit 1
      if [[ ${3:-} == --snapshot ]]; then
        cmd_snapshot "before-exam$n"
        info "Waiting for the cluster to come back after the snapshot"
        wait_cluster || die "the cluster didn't come back Ready after the snapshot"
      fi
      cmd_exam "$n" start ;;
    start)
      [[ -f $st/deadline ]] && (( $(date +%s) < $(<"$st/deadline") )) && die "exam $n is already running (lab exam $n status)"
      mkdir -p "$st"; rm -f "$st"/*
      local t pass
      # Two passes: tasks that break nodes or control-plane components (meta
      # DISRUPTIVE=1) are set up last, so they can't stall the other setups.
      for pass in 0 1; do
        for t in "$d"/tasks/*/; do
          t=${t%/}
          [[ $(meta "$t" DISRUPTIVE) == 1 ]] && (( pass == 0 )) && continue
          [[ $(meta "$t" DISRUPTIVE) != 1 ]] && (( pass == 1 )) && continue
          if [[ -x $t/setup.sh ]]; then
            printf '%s preparing %s\n' "${c_blue}::${c_off}" "$(basename "$t")"
            GRADE_ID=exam$n-$(basename "$t") bash "$t/setup.sh" >"$st/setup-$(basename "$t").log" 2>&1 \
              || die "setup of $(basename "$t") failed, see $st/setup-$(basename "$t").log"
          fi
        done
      done
      exam_contexts "$n" "$d" set
      echo $(( $(date +%s) + EXAM_MINUTES * 60 )) >"$st/deadline"
      info "Mock exam $n started: $EXAM_MINUTES minutes. Read it with: lab exam $n show"
      ;;
    show)
      if [[ -n ${3:-} ]]; then
        local t; t=$(compgen -G "$d/tasks/$(printf '%02d' "$((10#$3))")-*" | head -1)
        [[ -n $t ]] || die "no task $3"
        { echo "Context: kubectl config use-context e$n-t$((10#$3))"; echo; cat "$t/task.md"; } | less -FRX
      else
        { cat "$d/README.md"; for t in "$d"/tasks/*/; do echo; echo "---"; echo; cat "$t/task.md"; done; } | less -FRX
      fi
      ;;
    status)
      [[ -f $st/deadline ]] || die "exam $n not started"
      local left=$(( $(<"$st/deadline") - $(date +%s) ))
      (( left > 0 )) && info "$((left / 60)) min $((left % 60)) s left" || info "time is up (lab exam $n check)"
      ;;
    check)
      local t w frac got=0 max=0 line
      printf "${c_bold}%-34s %6s %8s${c_off}\n" TASK WEIGHT SCORE
      for t in "$d"/tasks/*/; do
        t=${t%/}
        w=$(meta "$t" WEIGHT)
        GRADE_QUIET=1 GRADE_ID=exam$n-$(basename "$t") bash "$t/check.sh" >/dev/null 2>&1
        line=$LAB_STATE/results/exam$n-$(basename "$t").json
        frac=$(jq -r '.pass / .total' "$line")
        got=$(awk -v g="$got" -v w="$w" -v f="$frac" 'BEGIN{print g + w*f}')
        max=$((max + w))
        printf "%-34s %5s%% %7.1f%%\n" "$(basename "$t")" "$w" "$(awk -v w="$w" -v f="$frac" 'BEGIN{print w*f}')"
      done
      local pct; pct=$(awk -v g="$got" -v m="$max" 'BEGIN{printf "%.0f", g*100/m}')
      jq -n --argjson n "$n" --argjson score "$pct" --argjson pass_mark "$EXAM_PASS" --arg at "$(date -u +%FT%TZ)" \
        '{exam:$n, score:$score, pass_mark:$pass_mark, passed:($score >= $pass_mark), at:$at}' \
        | tee "$LAB_STATE/results/exam$n.json" | jq -c . >>"$LAB_STATE/exam-history.jsonl"
      echo
      if (( pct >= EXAM_PASS )); then echo "${c_green}${c_bold}Score ${pct}% - PASS (needs ${EXAM_PASS}%)${c_off}"
      else echo "${c_red}${c_bold}Score ${pct}% - FAIL (needs ${EXAM_PASS}%)${c_off}"; fi
      echo "Per-check detail: GRADE_ID=... lab check is not used for exams; run bash $d/tasks/<task>/check.sh"
      ;;
    cleanup)
      [[ -f $d/cleanup.sh ]] || die "exam $n has no cleanup script"
      echo "${c_yellow}Tip:${c_off} 'lab reset before-exam$n' also undoes faults you didn't fix."
      run_cleanup "$d/cleanup.sh" "mock exam $n" "${3:-}"
      exam_contexts "$n" "$d" delete
      rm -rf "$st"
      ;;
    *) usage; exit 2 ;;
  esac
}

# --- speed drills ---------------------------------------------------------------
#
# One short task against a tight clock, with fresh values every attempt. The clock
# runs from setup to `lab drill check`; every check is recorded with its time.

drill_dir() {
  local id=$1 d
  d=$(compgen -G "$LAB_HOME/drills/$(printf '%02d' "$((10#$id))" 2>/dev/null)-*" | head -1)
  [[ -z $d ]] && d=$(compgen -G "$LAB_HOME/drills/$id" | head -1)
  [[ -n $d && -d $d ]] || die "no drill '$id' (try: lab drill list)"
  echo "$d"
}

fmt_secs() { printf '%d:%02d' $(( $1 / 60 )) $(( $1 % 60 )); }

cmd_drill() {
  local action=${1:-list} d id gid budget start
  case $action in
    list|ls)
      printf "${c_bold}%-28s %-10s %-7s %-9s %s${c_off}\n" DRILL DOMAIN BUDGET BEST TITLE
      for d in "$LAB_HOME"/drills/*/; do
        d=${d%/}; id=$(basename "$d"); gid=drill-$id
        local best; best=$(jq -rs --arg id "$gid" '[.[] | select(.id==$id and .pass==.total) | .seconds] | min // empty' "$LAB_STATE/drill-history.jsonl" 2>/dev/null)
        printf "%-28s %-10s %-7s %-9s %s\n" "$id" "$(meta "$d" DOMAIN)" "$(fmt_secs "$(meta "$d" SECONDS)")" "${best:+$(fmt_secs "$best")}" "$(meta "$d" TITLE)"
      done ;;
    random)
      local all=() dom=${2:-}
      for d in "$LAB_HOME"/drills/*/; do
        [[ -z $dom || $(meta "${d%/}" DOMAIN) == "$dom" ]] && all+=("$(basename "$d")")
      done
      (( ${#all[@]} )) || die "no drills${dom:+ in domain $dom}"
      cmd_drill "${all[RANDOM % ${#all[@]}]}" ;;
    check|grade)
      d=$(drill_dir "${2:?drill id}"); id=$(basename "$d"); gid=drill-$id
      start=$(cat "$LAB_STATE/drills/$gid.start" 2>/dev/null) || die "drill $id isn't running (lab drill $id)"
      local secs=$(( $(date +%s) - start )) rc
      budget=$(meta "$d" SECONDS)
      GRADE_ID=$gid bash "$d/check.sh"; rc=$?
      [[ -f $LAB_STATE/results/$gid.json ]] && jq -c --argjson s "$secs" --argjson b "$budget" '{id, pass, total, at, seconds: $s, budget: $b}' \
        "$LAB_STATE/results/$gid.json" >>"$LAB_STATE/drill-history.jsonl"
      if (( rc == 0 && secs <= budget )); then echo "${c_green}${c_bold}Time $(fmt_secs "$secs") of $(fmt_secs "$budget"): inside the budget${c_off}"
      elif (( rc == 0 )); then echo "${c_yellow}${c_bold}Time $(fmt_secs "$secs"): $(fmt_secs $(( secs - budget ))) over the $(fmt_secs "$budget") budget${c_off}"
      else echo "${c_dim}Time $(fmt_secs "$secs"); the clock keeps running until every check passes.${c_off}"; fi
      return $rc ;;
    cleanup|clean)
      d=$(drill_dir "${2:?drill id}"); id=$(basename "$d")
      GRADE_ID=drill-$id run_cleanup "$d/cleanup.sh" "drill $id" --yes
      rm -f "$LAB_STATE/drills/drill-$id.start" ;;
    *)
      d=$(drill_dir "$action"); id=$(basename "$d"); gid=drill-$id
      provision $(meta "$d" NEEDS)
      draw_params "$d" "$gid"
      info "Preparing drill $id ..."
      GRADE_ID=$gid bash "$d/setup.sh" || die "drill setup failed"
      mkdir -p "$LAB_STATE/drills"
      echo
      render "$d/task.md" "$gid"
      echo
      date +%s >"$LAB_STATE/drills/$gid.start"
      info "Clock started: $(fmt_secs "$(meta "$d" SECONDS)"). Grade with: lab drill check ${id%%-*}" ;;
  esac
}

# --- Proxmox snapshots -------------------------------------------------------------

pve() {
  local method=$1 path=$2; shift 2
  [[ -r $PVE_ENV ]] || die "snapshots need $PVE_ENV (installed by infra/install-lab.sh)"
  source "$PVE_ENV"
  curl -sS --fail-with-body -k -X "$method" -H "Authorization: PVEAPIToken=$PVE_TOKEN" \
    "$PVE_URL/api2/json/nodes/$PVE_NODE/qemu$path" "$@"
}

lab_vmids() { source "$LAB_ENV"; grep -Ev '^\s*(#|$)' <<<"$LAB_VMS" | awk -v r="${1:-}" 'r=="" || $8==r {print $2":"$1}'; }

wait_task() { # wait for a Proxmox task (UPID) to finish
  local upid=$1 status
  for _ in $(seq 1 180); do
    status=$(pve GET "/../tasks/$upid/status" 2>/dev/null | jq -r '.data.status // empty')
    [[ $status == stopped ]] && return 0
    sleep 2
  done
  return 1
}

# --- the jump host's share of a snapshot -----------------------------------------------
#
# Snapshots cover the six node VMs. The jump host isn't rolled back: what the labs
# install and write there (kubectl and its apt repo, Helm, HAProxy for the API load
# balancer, kubeconfig and answer files in the home directory) is saved alongside
# instead, and put back on reset. Progress (grades, exam history, web notes, logs)
# and the editor's server files are not part of it, so a reset keeps them, the web
# console keeps running and nobody is disconnected.

JUMP_SNAPS=/var/lib/cka-lab/snapshots
JUMP_PATHS=(/etc/apt/sources.list.d /etc/apt/keyrings /etc/haproxy /usr/local/bin /home/student)
# Home paths the labs own (task files name them): an exact restore mirrors these,
# deleting what was added since. Everything else in the home directory is only put
# back as it was, never deleted, so your own files survive a reset.
JUMP_HOME_OWNED=(.kube .config/helm .cka-lab answers kustomize exam1 exam2 helm rbac config calico backups cka-root-ca.crt)
JUMP_EXCLUDES=(                                   # relative to /home/student
  /.cka-lab/results /.cka-lab/history.jsonl /.cka-lab/exam-history.jsonl /.cka-lab/drill-history.jsonl
  /.cka-lab/quiz-history.jsonl /.cka-lab/web /.cka-lab/up
  /.cka-lab/grader.kubeconfig /.cka-lab/last-reset /.vscode-server /.config/Code /.cache /.ssh
)

jump_save() { # jump_save <name> [cache-key]
  local name=$1 key=${2:-} meta p paths=() ex=()
  meta=$(mktemp -d); mkdir "$meta/.lab-meta"
  apt-mark showmanual | sort >"$meta/.lab-meta/manual"
  apt-mark showhold | sort >"$meta/.lab-meta/hold"
  xargs -r dpkg-query -W -f='${Package}=${Version}\n' <"$meta/.lab-meta/manual" >"$meta/.lab-meta/versions" 2>/dev/null
  [[ -n $key ]] && echo "$key" >"$meta/.lab-meta/key"
  for p in "${JUMP_PATHS[@]}"; do [[ -e $p ]] && paths+=("${p#/}"); done
  for p in "${JUMP_EXCLUDES[@]}"; do ex+=("--exclude=home/student$p"); done
  sudo mkdir -p "$JUMP_SNAPS"
  sudo tar -czf "$JUMP_SNAPS/$name.tgz.tmp" "${ex[@]}" -C / "${paths[@]}" -C "$meta" .lab-meta \
    && sudo mv "$JUMP_SNAPS/$name.tgz.tmp" "$JUMP_SNAPS/$name.tgz"
  local rc=$?; rm -rf "$meta"; return $rc
}

# jump_restore <name> [add]: make the jump host's lab state what it was at <name>.
# Default is exact: files and packages added since are removed, as a rollback would.
# "add" only puts back what's missing (used by lab up, which must not delete your files).
jump_restore() {
  local name=$1 mode=${2:-exact} st p cur extra missing del=() ex=()
  [[ -f $JUMP_SNAPS/$name.tgz ]] || return 1
  st=$(mktemp -d)
  sudo tar -xzf "$JUMP_SNAPS/$name.tgz" -C "$st" || { sudo rm -rf "$st"; return 1; }
  [[ $mode == exact ]] && del=(--delete)
  for p in "${JUMP_EXCLUDES[@]}"; do ex+=("--exclude=$p"); done
  # Repositories first: package versions are installed from them.
  for p in /etc/apt/sources.list.d /etc/apt/keyrings; do
    [[ -d $st$p ]] && sudo rsync -a "${del[@]}" "$st$p/" "$p/"
  done
  cur=$(apt-mark showmanual | sort)
  # Packages that were installed by hand at the snapshot, at the version they had then.
  # Kernel and firmware packages move with Ubuntu's own updates; they aren't lab state.
  missing=$(while IFS='=' read -r pkg ver; do
    [[ $pkg == linux-* || $pkg == firmware-* ]] && continue
    [[ $(dpkg-query -W -f='${Version}' "$pkg" 2>/dev/null) == "$ver" ]] || echo "$pkg=$ver"
  done <"$st/.lab-meta/versions")
  [[ -n $missing ]] && sudo apt-get update -qq >/dev/null 2>&1   # slow: only when something must be installed
  if [[ $mode == exact ]]; then
    extra=$(comm -23 <(echo "$cur") "$st/.lab-meta/manual" | grep -Ev '^(linux|firmware)-')
    if [[ -n $extra ]]; then
      sudo apt-mark unhold $extra >/dev/null 2>&1
      sudo DEBIAN_FRONTEND=noninteractive apt-get purge -y -qq $extra >/dev/null 2>&1 && info "jump: removed $(xargs <<<"$extra")"
    fi
  fi
  if [[ -n $missing ]]; then
    sudo apt-mark unhold $(sed 's/=.*//' <<<"$missing") >/dev/null 2>&1
    sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --allow-downgrades --allow-change-held-packages $missing >/dev/null 2>&1 \
      && info "jump: installed $(xargs <<<"$missing")" || info "jump: couldn't install $(xargs <<<"$missing")"
  fi
  [[ -s $st/.lab-meta/hold ]] && sudo apt-mark hold $(cat "$st/.lab-meta/hold") >/dev/null 2>&1
  for p in /etc/haproxy /usr/local/bin; do
    # (never delete the lab command itself, linked into /usr/local/bin by the installer)
    if [[ -d $st$p ]]; then sudo rsync -a "${del[@]}" --exclude=/lab "$st$p/" "$p/"
    elif [[ $mode == exact && $p == /etc/haproxy ]]; then sudo rm -rf "$p"; fi
  done
  sudo rsync -a "${ex[@]}" "$st/home/student/" /home/student/
  if [[ $mode == exact ]]; then
    local inner=()   # the progress excludes, relative to ~/.cka-lab
    for p in "${JUMP_EXCLUDES[@]}"; do [[ $p == /.cka-lab/* ]] && inner+=("--exclude=${p#/.cka-lab}"); done
    for p in "${JUMP_HOME_OWNED[@]}"; do
      if [[ $p == .cka-lab ]]; then   # holds your progress: mirror around it, never remove it
        [[ -d $st/home/student/.cka-lab ]] && sudo rsync -a --delete "${inner[@]}" "$st/home/student/.cka-lab/" /home/student/.cka-lab/
      elif [[ -d $st/home/student/$p ]]; then sudo rsync -a --delete "$st/home/student/$p/" "/home/student/$p/"
      elif [[ ! -e $st/home/student/$p && -e /home/student/$p ]]; then sudo rm -rf "/home/student/$p"; fi
    done
  fi
  sudo chown -R student:student /home/student/.cka-lab 2>/dev/null
  # HAProxy is the API load balancer from lab 02: run it with the restored config.
  if [[ -f /etc/haproxy/haproxy.cfg ]] && command -v haproxy >/dev/null; then
    sudo systemctl enable --now haproxy >/dev/null 2>&1; sudo systemctl restart haproxy
  fi
  sudo rm -rf "$st"
}

node_vm_snapshots() { # names of snapshots every node VM has
  local vm vms; vms=$(lab_vmids node)
  for vm in $vms; do
    pve GET "/${vm%%:*}/snapshot" | jq -r '.data[] | select(.name != "current") | .name'
  done | sort | uniq -c | awk -v n="$(wc -w <<<"$vms")" '$1 == n {print $2}'
}

# Wait until the cluster works again after a snapshot or rollback: every node Ready,
# and the controllers running (a new namespace gets its default ServiceAccount; right
# after a restart the static Pods come back before kube-controller-manager leads again).
wait_cluster() {
  local want=${#K8S_NODES[@]} ready k=("$GRADER_KUBECTL" --kubeconfig "$HOME/.kube/config" --request-timeout=10s) ns=lab-wait-$RANDOM
  for _ in $(seq 1 90); do
    ready=$("${k[@]}" get nodes --no-headers 2>/dev/null | awk '$2 == "Ready"' | wc -l)
    (( ready == want )) && break
    sleep 5
  done
  (( ready == want )) || return 1
  "${k[@]}" create namespace "$ns" >/dev/null 2>&1 || return 1
  for _ in $(seq 1 60); do
    if "${k[@]}" -n "$ns" get serviceaccount default >/dev/null 2>&1; then
      "${k[@]}" delete namespace "$ns" --wait=false >/dev/null 2>&1; return 0
    fi
    sleep 3
  done
  "${k[@]}" delete namespace "$ns" --wait=false >/dev/null 2>&1
  return 1
}

# --- power: the cluster VMs run only while they're needed ---------------------------
#
# HelmYard can be switched off completely (the gate on Proxmox starts the jump host
# again). The node VMs are started by any lab command that needs the cluster, and
# shut down by `lab power off` or when the web console has been idle for a while.

# nodes_state: "<name> <status>" for every node VM, from one Proxmox call.
nodes_state() {
  local all; all=$(pve GET "" | jq -c '[.data[] | {vmid, status}]') || return 1
  lab_vmids node | while IFS=: read -r vmid name; do
    printf '%s %s\n' "$name" "$(jq -r --argjson id "$vmid" '.[] | select(.vmid == $id) | .status' <<<"$all")"
  done
}

# wait_nodes: every node answers SSH, then, once there is a cluster, it's Ready.
wait_nodes() {
  local n
  for n in "${K8S_NODES[@]}" nfs; do wait_for 300 node_up "$n" || die "$n didn't come up after starting"; done
  if [[ -f $HOME/.kube/config ]]; then
    info "Waiting for Kubernetes"
    wait_cluster || die "the nodes are up but the cluster isn't Ready; check lab power status and kubectl get nodes"
  fi
}

power_on() {
  local name st vmid started=0
  while read -r name st; do
    [[ $st == running ]] && continue
    vmid=$(lab_vmids node | awk -F: -v n="$name" '$2 == n {print $1}')
    pve POST "/$vmid/status/start" >/dev/null && started=1 && info "$name: starting"
  done < <(nodes_state)
  (( started )) || { info "The cluster VMs are already running"; return 0; }
  wait_nodes && info "Cluster VMs up"
}

power_off() {
  local name st vmid upid upids=()
  while read -r name st; do
    [[ $st == running ]] || continue
    vmid=$(lab_vmids node | awk -F: -v n="$name" '$2 == n {print $1}')
    upid=$(pve POST "/$vmid/status/shutdown" -d timeout=180 -d forceStop=1 | jq -r .data) && upids+=("$upid") && info "$name: shutting down"
  done < <(nodes_state)
  for upid in "${upids[@]}"; do wait_task "$upid"; done
  rm -f "$GRADER_KUBECONFIG"
  info "Cluster VMs off"
}

# ensure_nodes: start the cluster VMs if any is off (no-op without Proxmox access).
ensure_nodes() {
  [[ -r $PVE_ENV && -r $LAB_ENV ]] || return 0
  local states; states=$(nodes_state 2>/dev/null) || return 0
  awk '$2 != "running"' <<<"$states" | grep -q . || return 0
  info "The cluster VMs are off; starting them first"
  power_on
}

cmd_power() {
  case ${1:-status} in
    status)
      [[ -r $PVE_ENV ]] || die "power control needs $PVE_ENV (installed by infra/install-lab.sh)"
      printf '%-8s %s\n' jump running
      nodes_state ;;
    on) power_on ;;
    off) power_off ;;
    shutdown)
      power_off
      info "Shutting down the jump host. Start HelmYard again from the gate page."
      sudo systemctl poweroff --no-block ;;
    *) usage; exit 2 ;;
  esac
}

# --- live snapshots: the cluster with its memory, back in seconds ----------------------
#
# A snapshot with the VMs' RAM (Proxmox vmstate) rolls back to *running* VMs: no boot,
# no kubelet start, no cold etcd election. All node VMs are paused first, so the whole
# cluster is frozen at one instant and nothing writes while the memory is saved. (Saving
# from running VMs stalled their disks for minutes and once left containerd's database
# on a control plane corrupt.) The cluster then continues from the snapshot itself, so
# saving is checked by a restore. Each costs the RAM in use on the VM storage.

parallel_task() { # parallel_task <method> <path suffix> [curl args]: on every node VM, wait for all
  local method=$1 suffix=$2 vm upid upids=(); shift 2
  for vm in $(lab_vmids node); do
    upid=$(pve "$method" "/${vm%%:*}$suffix" "$@" 2>/dev/null | jq -r '.data // empty') && [[ -n $upid ]] && upids+=("$upid")
  done
  for upid in "${upids[@]}"; do wait_task "$upid"; done
}

snapshot_live() { # snapshot_live <name> <description>
  # Most of the nodes' RAM is file cache. Drop it first: the balloon driver reports the
  # freed pages to the host, which discards them, and QEMU saves zero pages as a flag.
  local n pids=() ok=0
  for n in "${K8S_NODES[@]}" nfs; do
    on "$n" sh -c 'sync; echo 3 >/proc/sys/vm/drop_caches; echo 1 >/proc/sys/vm/compact_memory' & pids+=($!)
  done
  wait "${pids[@]}"; sleep 5    # free page reporting runs every couple of seconds
  parallel_task DELETE "/snapshot/$1"
  parallel_task POST /status/suspend                    # freeze the cluster at one instant
  parallel_task POST /snapshot -d snapname="$1" -d vmstate=1 -d description="$2 $(date -u +%FT%TZ)"
  [[ $(node_vm_snapshots | grep -cx "$1") == 1 ]] && ok=1
  # Saving a paused VM's memory leaves QEMU in "finish-migrate", which a plain resume can't
  # leave. Come back the way every later spin-up does: from the snapshot just taken.
  rollback_live "$1" || return 1
  (( ok ))
}

rollback_live() { # rollback_live <name>: stop, roll back (RAM included: they come back running)
  parallel_task POST /status/stop
  parallel_task POST "/snapshot/$1/rollback" -d start=1
  parallel_task POST /status/resume     # saved while paused: make sure they run
  # The guests' clocks are where the snapshot left them: set them from the jump host.
  local n pids=()
  for n in "${K8S_NODES[@]}" nfs; do wait_for 60 node_up "$n" || return 1; done
  for n in "${K8S_NODES[@]}" nfs; do on "$n" date -s "@$(date +%s.%N)" >/dev/null & pids+=($!); done
  wait "${pids[@]}"   # only these: the caller may have its own background jobs
  rm -f "$GRADER_KUBECONFIG"
}

# labs_key <nums...>: what a cached cluster depends on (setup scripts and reference solutions).
labs_key() {
  local n dirs=()
  for n in "$@"; do dirs+=("$(lab_dir "$n")" "$LAB_SOLUTIONS/labs/$(basename "$(lab_dir "$n")")"); done
  find "${dirs[@]}" -type f ! -name '*.md' ! -name check.sh ! -name cleanup.sh ! -name meta -print0 2>/dev/null |
    sort -z | xargs -0 cat | sha1sum | cut -c1-12
}

live_cached() { # live_cached <snapshot> <key>: on every node, with RAM, for these sources
  [[ -r $PVE_ENV && -f $JUMP_SNAPS/$1.tgz ]] || return 1
  [[ $(sudo tar -xzOf "$JUMP_SNAPS/$1.tgz" .lab-meta/key 2>/dev/null) == "$2" ]] || return 1
  local vm
  for vm in $(lab_vmids node); do
    pve GET "/${vm%%:*}/snapshot" | jq -e --arg s "$1" '.data[] | select(.name == $s and .vmstate == 1)' >/dev/null || return 1
  done
}

# --- playground: a working cluster to experiment on -----------------------------------

PLAYGROUND_CORE="07"                        # 01-07: HA control plane, 2 workers, Calico, v1.35
PLAYGROUND_FULL="07 09 10 20 22 23 25"      # + metrics-server, cert-manager, MetalLB, Traefik, Envoy Gateway, NFS

# The first spin-up of a preset builds it with the reference solutions (slow, once) and
# saves it as a live snapshot, pg-<preset>. Every spin-up after that restores the snapshot:
# under a minute. Like a reset, that replaces whatever is on the cluster now.
cmd_playground() {
  local preset=${1:-core} want snap t0=$SECONDS key n
  case $preset in
    core) want=$PLAYGROUND_CORE ;;
    full) want=$PLAYGROUND_FULL ;;
    *) die "usage: lab playground [core|full] [--rebuild|--save]" ;;
  esac
  snap=pg-$preset
  key=$(labs_key $(closure $want))
  mkdir -p "$LAB_STATE/provisioned"
  if [[ ${2:-} == --save ]]; then
    # Save the cluster as it is now as this preset (e.g. after restoring it and changing nothing).
    info "Saving the current cluster as the live snapshot $snap"
    snapshot_live "$snap" "lab playground $preset: labs $(closure $want | sort -n | xargs)" && jump_save "$snap" "$key" \
      || die "saving $snap failed"
    info "Saved in $(( (SECONDS - t0) / 60 ))m$(( (SECONDS - t0) % 60 ))s"
    return 0
  fi
  if [[ ${2:-} != --rebuild ]] && live_cached "$snap" "$key"; then
    info "Restoring the $preset playground from its live snapshot $snap"
    # The jump host's share and the VMs' rollback don't depend on each other: do both at once.
    local jlog=$LAB_STATE/up/playground-jump.log jpid
    mkdir -p "$LAB_STATE/up"
    jump_restore "$snap" add >"$jlog" 2>&1 & jpid=$!
    rollback_live "$snap" || die "the nodes didn't come back after the rollback; check lab power status"
    info "Node VMs resumed ($(( SECONDS - t0 ))s)"
    wait "$jpid" || die "couldn't restore the jump host's lab state from $snap (log: $jlog)"
    info "Jump host's tools and kubeconfig back ($(( SECONDS - t0 ))s)"
    wait_cluster || die "the cluster isn't Ready after the restore; try again, or lab playground $preset --rebuild"
    info "Every node Ready, controllers running ($(( SECONDS - t0 ))s)"
    for n in $(closure $want); do date -u +%FT%TZ >"$LAB_STATE/provisioned/$(basename "$(lab_dir "$n")")"; done
    date +%s >"$LAB_STATE/last-reset"
  else
    ensure_nodes
    provision $want
    if [[ -r $PVE_ENV ]]; then
      info "Saving it as the live snapshot $snap, so the next spin-up takes under a minute"
      if snapshot_live "$snap" "lab playground $preset: labs $(closure $want | sort -n | xargs)"; then
        jump_save "$snap" "$key" || info "couldn't save the jump host's share; the next spin-up rebuilds"
      else
        info "the live snapshot failed (does the API token have Datastore.AllocateSpace? re-run infra/install-lab.sh); carrying on without it"
      fi
    fi
  fi
  mkdir -p "$LAB_STATE" && echo "$preset" >"$LAB_STATE/playground"
  info "Playground ready ($preset) in $(( (SECONDS - t0) / 60 ))m$(( (SECONDS - t0) % 60 ))s. The cluster is yours: kubectl get nodes -o wide"
}

cmd_snapshots() {
  local vm vmid name
  for vm in $(lab_vmids node); do
    vmid=${vm%%:*}; name=${vm#*:}
    printf '%-8s %s\n' "$name" "$(pve GET "/$vmid/snapshot" | jq -r '[.data[] | select(.name != "current") | .name] | join("  ")')"
  done
  printf '%-8s %s\n' jump "$(cd "$JUMP_SNAPS" 2>/dev/null && ls -1 -- *.tgz 2>/dev/null | sed 's/\.tgz$//' | xargs) ${c_dim}(lab state only)${c_off}"
}

cmd_snapshot_delete() {
  local snap=${1:-} vm vmid name upid
  [[ $snap =~ ^[A-Za-z][A-Za-z0-9_-]{1,39}$ ]] || die "usage: lab snapshots delete <name>"
  [[ $snap == base ]] && die "'base' is the bare-Ubuntu starting point; it can't be deleted from here"
  for vm in $(lab_vmids); do   # older snapshots also exist on the jump VM itself
    vmid=${vm%%:*}; name=${vm#*:}
    if upid=$(pve DELETE "/$vmid/snapshot/$snap" 2>/dev/null | jq -r .data) && [[ -n $upid && $upid != null ]]; then
      wait_task "$upid" && info "$name: deleted $snap"
    else
      [[ $name != jump ]] && info "$name: no snapshot $snap"
    fi
  done
  [[ -f $JUMP_SNAPS/$snap.tgz ]] && sudo rm -f "$JUMP_SNAPS/$snap.tgz" && info "jump: deleted $snap"
}

# snapshot_nodes <name> [description]: stop the nodes, snapshot them, start them again.
snapshot_nodes() {
  local snap=$1 desc=${2:-lab snapshot} vm vmid name upid upids=()
  # Shut down in parallel: each node can take ~90s while systemd stops containerd.
  for vm in $(lab_vmids node); do
    upids+=("$(pve POST "/${vm%%:*}/status/shutdown" -d timeout=180 -d forceStop=1 | jq -r .data)")
  done
  for upid in "${upids[@]}"; do wait_task "$upid"; done
  for vm in $(lab_vmids node); do
    vmid=${vm%%:*}; name=${vm#*:}
    pve DELETE "/$vmid/snapshot/$snap" >/dev/null 2>&1 && sleep 3
    upid=$(pve POST "/$vmid/snapshot" -d snapname="$snap" -d description="$desc $(date -u +%FT%TZ)" | jq -r .data)
    wait_task "$upid" && info "$name: snapshot $snap"
  done
  for vm in $(lab_vmids node); do pve POST "/${vm%%:*}/status/start" >/dev/null; done
}

cmd_snapshot() {
  local snap=${1:-}
  [[ $snap =~ ^[A-Za-z][A-Za-z0-9_-]{1,39}$ ]] || die "snapshot names: letters, digits, - and _, starting with a letter"
  [[ $snap == base ]] && die "'base' is reserved for the bare-Ubuntu snapshot"
  info "Stopping nodes for a consistent snapshot (etcd on 3 members must be captured together)"
  snapshot_nodes "$snap"
  jump_save "$snap" && info "jump: lab state saved as $snap" || die "couldn't save the jump host's lab state"
  info "Nodes starting; the cluster is back in a minute or two"
}

# rollback_nodes <name>: roll every node VM back to a snapshot and start it.
rollback_nodes() {
  local snap=$1 vm vmid name upid
  for vm in $(lab_vmids node); do
    vmid=${vm%%:*}; name=${vm#*:}
    pve POST "/$vmid/status/stop" >/dev/null 2>&1 && sleep 2
    upid=$(pve POST "/$vmid/snapshot/$snap/rollback" | jq -r .data) || die "$name has no snapshot $snap"
    wait_task "$upid"; pve POST "/$vmid/status/start" >/dev/null
    info "$name: rolled back to $snap"
  done
}

cmd_reset() {
  local snap=${1:-} vm vmid
  [[ -n $snap ]] || die "usage: lab reset <snapshot>"
  if [[ -f $JUMP_SNAPS/$snap.tgz ]]; then
    read -rp "Roll the cluster back to '$snap'? Cluster changes and lab files on jump since then are lost; grades and notes are kept. [y/N] " ok
    [[ $ok == y ]] || exit 0
    rollback_nodes "$snap"
    jump_restore "$snap" && info "jump: lab state restored to $snap"
    rm -f "$GRADER_KUBECONFIG"
    date +%s >"$LAB_STATE/last-reset"
    info "Nodes starting; the cluster is back in a minute or two"
    return 0
  fi
  # Snapshots from before the jump's lab state was saved separately include the jump
  # VM itself: roll it back too, the old way (this session ends, progress since is lost).
  read -rp "Roll ALL lab VMs back to '$snap', including the jump host? Everything since is lost, grades too. [y/N] " ok
  [[ $ok == y ]] || exit 0
  rollback_nodes "$snap"
  vm=$(lab_vmids jump); vmid=${vm%%:*}
  info "Rolling back the jump host; you'll be disconnected. Reconnect in about a minute."
  pve POST "/$vmid/snapshot/$snap/rollback" -d start=1 >/dev/null
}

# Commands that work on the cluster start its VMs first if they are off.
case ${1:-}:${2:-} in
  start:*|up:*|check:*|grade:*|cleanup:*|clean:*|snapshot:*) ensure_nodes ;;   # playground decides itself
  exam:*) [[ ${3:-} =~ ^(start|prep|up|begin|check|cleanup)$ ]] && ensure_nodes ;;
  drill:*|drills:*) [[ ${2:-list} =~ ^(list|ls)$ ]] || ensure_nodes ;;
esac

case ${1:-} in
  list|ls) cmd_list ;;
  show) cmd_show "${2:?lab id}" ;;
  start) shift; cmd_start "${1:?lab id}" "${@:2}" ;;
  up) shift; cmd_up "${1:?lab id}" "${@:2}" ;;
  check|grade) cmd_check "${2:?lab id}" ;;
  solution) cmd_solution "${2:?lab id}" ;;
  cleanup|clean) cmd_cleanup "${2:?lab id}" "${3:-}" ;;
  exam) shift; cmd_exam "$@" ;;
  drill|drills) shift; cmd_drill "$@" ;;
  snapshots)
    case ${2:-} in
      "") cmd_snapshots ;;
      delete|rm) cmd_snapshot_delete "${3:-}" ;;
      *) usage; exit 2 ;;
    esac ;;
  snapshot) cmd_snapshot "${2:-}" ;;
  power) cmd_power "${2:-status}" ;;
  playground) cmd_playground "${2:-core}" "${3:-}" ;;
  # Save only the jump host's lab state under a snapshot name (used by the installer for
  # "base", and to bring snapshots taken before this existed up to date).
  jump-state) [[ ${2:-} =~ ^[A-Za-z][A-Za-z0-9_-]{1,39}$ ]] || die "usage: lab jump-state <name>"; jump_save "$2" && info "jump: lab state saved as $2" ;;
  reset) cmd_reset "${2:-}" ;;
  ""|-h|--help|help) usage ;;
  *) usage; exit 2 ;;
esac
