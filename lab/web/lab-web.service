# Browser console for the CKA lab (lab/web/server.py). Installed by infra/install-lab.sh.
[Unit]
Description=CKA lab web console
After=network-online.target
Wants=network-online.target

[Service]
User=student
Group=student
WorkingDirectory=/home/student
Environment=HOME=/home/student LAB_HOME=/opt/cka-lab PYTHONUNBUFFERED=1
EnvironmentFile=/etc/cka-lab/web.env
ExecStart=/usr/bin/python3 /opt/cka-lab/web/server.py
# Port 443 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
