# CKA lab topology: the single source of truth for VM IDs, sizes and addresses.
# Sourced by infra/deploy.sh (laptop) and infra/proxmox/build.sh (Proxmox host).

LAB_DOMAIN=cka.lab
LAB_NET=10.10.10.0/24
LAB_GW=10.10.10.10            # jump host's lab-side address: NAT gateway + DNS
LAB_BRIDGE=vmbr1              # isolated, no uplink
UPLINK_BRIDGE=vmbr0           # your LAN; only the jump host is attached
TEMPLATE_ID=9000              # Ubuntu 24.04 cloud image, no Kubernetes
STORAGE=local-lvm
SNIPPETS_STORAGE=local        # cloud-init user-data lives in local:snippets/

# Kubernetes API endpoint the student puts in front of the control plane.
API_ENDPOINT=k8s-api.cka.lab  # resolves to $LAB_GW (HAProxy, built in lab 01)
METALLB_RANGE=10.10.10.200-10.10.10.220

# name      vmid  ip            cores  mem_mb  disk_gb  extra_disk_gb  role
LAB_VMS="
jump        200   10.10.10.10   2      2048    20       0              jump
cp1         201   10.10.10.11   2      4096    40       0              node
cp2         202   10.10.10.12   2      4096    40       0              node
cp3         203   10.10.10.13   2      4096    40       0              node
worker1     204   10.10.10.21   3      6144    40       0              node
worker2     205   10.10.10.22   3      6144    40       0              node
nfs         206   10.10.10.30   1      1024    20       60             node
"
